# Use a DNS name you control; point its A record to the ECS public IPv4 address.
DOMAIN=dealguard.example.com

# Use letters and numbers only so the generated PostgreSQL URL needs no escaping.
POSTGRES_DB=dealguard
POSTGRES_USER=dealguard
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret

# Optional OpenAI-compatible model endpoint. Leave blank to use deterministic parsing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
ACTION_PLANNER_ENABLED=true

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=5
